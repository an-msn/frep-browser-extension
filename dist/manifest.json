{
    "manifest_version": 2,
    "version": "1.0.0",
    "content_security_policy": "script-src 'self' 'unsafe-eval'; object-src 'self'",
    "name": "Frep",
    "background": { "scripts": ["src/background.js"] },
    "action": {
        "default_popup": "src/popup.html",
        "default_icon": "assets/img/icon-34.png"
    },
    "permissions": ["tabs", "contextMenus"],
    "icons": {
        "128": "assets/img/icon-128.png"
    },
    "content_scripts": [
        {
            "matches": ["http://*/*", "https://*/*"],
            "js": ["src/content.js"],
            "css": ["src/content.style.css"],
            "all_frames": true,
            "match_about_blank": true
        }
    ],
    "web_accessible_resources": ["assets/*", "content.styles.css"]
}
